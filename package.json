{
  "name": "ananda-sangha-event-desk",
  "version": "2.0.0-beta.5.48",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare:assets": "node scripts/prepare-assets.js",
    "dist:win": "npm run prepare:assets && electron-builder --win nsis --x64 --publish never",
    "test:attendance": "node scripts/verify-attendance.js",
    "test:ai": "node scripts/verify-ai-attendance.js",
    "test:ai-settings": "node scripts/verify-ai-settings.js",
    "test:qr-print": "node scripts/verify-qr-print.js",
    "test:ai-recovery": "node scripts/verify-ai-recovery.js",
    "test:ai-performance": "node scripts/verify-ai-performance.js",
    "test:attendance-permission": "node scripts/verify-attendance-permission.js",
    "test:attendance-ui": "node scripts/verify-attendance-ui-state.js",
    "test:unified": "node scripts/verify-unified-attendance.js",
    "test:batch-count": "node scripts/verify-batch-class-count.js",
    "test:enrol-shortcut": "node scripts/verify-enrol-shortcut.js",
    "test:attendance-status": "node scripts/verify-attendance-status.js",
    "test:page-two": "node scripts/verify-page-two-qr.js",
    "test:absent-button": "node scripts/verify-absent-button.js",
    "test:progression": "node scripts/verify-course-progression-threshold.js",
    "test:kriya-schedule": "node scripts/verify-kriya-custom-schedule.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "electron": "^36.9.0",
    "electron-builder": "^26.0.12",
    "browserify": "^17.0.1"
  },
  "build": {
    "appId": "org.anandasangha.gurgaon.eventdesk",
    "productName": "Ananda Sangha Event Desk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "logo-128.png",
      "ananda-icon.ico",
      "qrcode-client.js",
      "jsqr-client.js",
      "omr-scanner.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "ananda-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ananda Sangha Event Desk",
      "uninstallDisplayName": "Ananda Sangha Event Desk"
    }
  }
}
