{
  "name": "ananda-sangha-event-desk",
  "version": "2.0.0-beta.1",
  "description": "ANANDA SANGHA GURGAON Event Desk - Phase 2 NGO Database Beta",
  "author": "ANANDA SANGHA GURGAON",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "39.1.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "org.anandasangha.gurgaon.eventdesk",
    "productName": "Ananda Sangha Event Desk",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "logo-128.png",
      "ananda-icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "ananda-icon.ico",
      "artifactName": "Ananda_Sangha_Event_Desk_Phase2_Setup_v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ananda Sangha Event Desk",
      "installerIcon": "ananda-icon.ico",
      "uninstallerIcon": "ananda-icon.ico",
      "installerHeaderIcon": "ananda-icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Ananda Sangha Event Desk",
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0"
  }
}
