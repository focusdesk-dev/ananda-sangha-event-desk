<Window x:Class="AnandaModernInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ananda Sangha Setup"
        Width="920" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="White"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
  <Border BorderBrush="#D9E3EE" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Background="#0B2F6B" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
        <Ellipse Width="520" Height="520" Margin="-95,-235,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Stroke="#29E9B62F" StrokeThickness="52"/>
        <Ellipse Width="390" Height="390" Margin="-30,-145,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Stroke="#22FFFFFF" StrokeThickness="2"/>
        <Path Data="M0,420 L85,328 L142,374 L224,280 L330,390 L330,560 L0,560 Z"
              Fill="#143D75" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
        <Path Data="M0,470 L72,392 L130,430 L205,355 L275,410 L330,372 L330,560 L0,560 Z"
              Fill="#1B4A84" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-35,0,0">
          <Border Width="112" Height="112" CornerRadius="56" Background="#10FFFFFF" Padding="8">
            <Image Source="pack://application:,,,/Assets/logo.png" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="ANANDA SANGHA" Foreground="White" FontSize="23" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,22,0,0" CharacterSpacing="70"/>
          <TextBlock Text="MEDITATION · SERVICE · JOY" Foreground="#D5E4F5" FontSize="10"
                     HorizontalAlignment="Center" Margin="0,8,0,0" CharacterSpacing="120"/>
        </StackPanel>

        <StackPanel VerticalAlignment="Bottom" Margin="34,0,34,30">
          <Rectangle Height="2" Fill="#E9B62F" Width="58" HorizontalAlignment="Left"/>
          <TextBlock Text="ANANDA SANGHA GURGAON" Foreground="#BFD2E8" FontSize="10" FontWeight="SemiBold"
                     Margin="0,10,0,0" CharacterSpacing="80"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Column="1" Background="White">
        <Button x:Name="CloseButton" Content="×" Width="42" Height="42" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,12,14,0" Background="Transparent" BorderThickness="0" Foreground="#6E8194" FontSize="23"
                Click="CloseButton_Click"/>

        <Grid Margin="58,58,58,94">
          <Grid x:Name="WelcomePage">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="WELCOME TO" Foreground="#E0A820" FontSize="12" FontWeight="Bold" CharacterSpacing="150"/>
              <TextBlock Text="Welcome To&#x0a;Ananda Sangha" Foreground="#0B2F6B" FontSize="40" FontWeight="SemiBold"
                         LineHeight="49" Margin="0,11,0,0"/>
            </StackPanel>
          </Grid>

          <Grid x:Name="LicensePage" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="LICENSE AGREEMENT" Foreground="#E0A820" FontSize="12" FontWeight="Bold" CharacterSpacing="150"/>
              <TextBlock Text="License Agreement" Foreground="#0B2F6B" FontSize="31" FontWeight="SemiBold" Margin="0,8,0,20"/>
            </StackPanel>
            <Border Grid.Row="1" Background="#F7FAFD" BorderBrush="#DCE6EF" BorderThickness="1" CornerRadius="12" Padding="16">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Foreground="#536B83" FontSize="12.5" LineHeight="20" TextWrapping="Wrap">
                  <Run Text="ANANDA SANGHA EVENT DESK SOFTWARE LICENSE&#x0a;&#x0a;"/>
                  <Run Text="This software is provided for the internal administrative use of Ananda Sangha Gurgaon. It may be installed on authorised organisation computers for event, class, attendance and related record management.&#x0a;&#x0a;"/>
                  <Run Text="Organisation data remains the responsibility of the authorised user. Keep regular backups and protect administrator credentials. Do not distribute the software or organisation records to unauthorised persons.&#x0a;&#x0a;"/>
                  <Run Text="By continuing, you confirm that you are authorised to install and use this software on this computer."/>
                </TextBlock>
              </ScrollViewer>
            </Border>
            <CheckBox x:Name="AcceptLicense" Grid.Row="2" Content="I accept the license agreement"
                      Foreground="#173E6A" FontWeight="SemiBold" Margin="2,16,0,0"
                      Checked="AcceptLicense_Changed" Unchecked="AcceptLicense_Changed"/>
          </Grid>

          <Grid x:Name="LocationPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="INSTALLATION" Foreground="#E0A820" FontSize="12" FontWeight="Bold" CharacterSpacing="150"/>
              <TextBlock Text="Choose Install Location" Foreground="#0B2F6B" FontSize="31" FontWeight="SemiBold" Margin="0,8,0,8"/>
              <TextBlock Text="Choose where Ananda Sangha will be installed." Foreground="#6B7F94" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,28,0,0">
              <TextBlock Text="INSTALL LOCATION" Foreground="#173E6A" FontSize="11" FontWeight="Bold"/>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="InstallPathBox" Height="44" VerticalContentAlignment="Center" Padding="12,0"
                         BorderBrush="#C9D7E5" BorderThickness="1" Background="#FBFDFF" Foreground="#173E6A"/>
                <Button Grid.Column="1" Content="Browse" Width="92" Margin="10,0,0,0" Background="#F4F8FC"
                        BorderBrush="#C9D7E5" Foreground="#173E6A" Click="BrowseButton_Click"/>
              </Grid>
            </StackPanel>
            <Border Grid.Row="2" Background="#F7FAFD" BorderBrush="#DFE8F0" BorderThickness="1" CornerRadius="12"
                    Padding="16" Margin="0,22,0,0">
              <StackPanel>
                <CheckBox x:Name="DesktopShortcut" Content="Create a desktop shortcut" IsChecked="True" Foreground="#173E6A"/>
                <CheckBox x:Name="StartMenuShortcut" Content="Create a Start Menu shortcut" IsChecked="True" Foreground="#173E6A" Margin="0,12,0,0"/>
                <CheckBox x:Name="LaunchAfterInstall" Content="Launch Ananda Sangha after installation" IsChecked="True" Foreground="#173E6A" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
          </Grid>

          <Grid x:Name="InstallingPage" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="INSTALLING" Foreground="#E0A820" FontSize="12" FontWeight="Bold" CharacterSpacing="150"/>
              <TextBlock Text="Installing Ananda Sangha" Foreground="#0B2F6B" FontSize="31" FontWeight="SemiBold" Margin="0,8,0,8"/>
              <TextBlock x:Name="InstallStatus" Text="Preparing installation…" Foreground="#6B7F94" FontSize="13"/>
              <Border x:Name="ProgressTrack" Height="10" Background="#E7EEF5" CornerRadius="5" Margin="0,32,0,0" SizeChanged="ProgressTrack_SizeChanged">
                <Grid>
                  <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" Background="#E9B62F" CornerRadius="5"/>
                </Grid>
              </Border>
              <TextBlock x:Name="ProgressPercent" Text="0%" Foreground="#173E6A" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,8,0,0"/>
              <StackPanel Margin="0,28,0,0">
                <TextBlock x:Name="StepCopy" Text="Copying files…" Foreground="#8A9CAF" FontSize="13"/>
                <TextBlock x:Name="StepComponents" Text="Installing components…" Foreground="#8A9CAF" FontSize="13" Margin="0,10,0,0"/>
                <TextBlock x:Name="StepShortcuts" Text="Creating shortcuts…" Foreground="#8A9CAF" FontSize="13" Margin="0,10,0,0"/>
                <TextBlock x:Name="StepFinal" Text="Finalising installation…" Foreground="#8A9CAF" FontSize="13" Margin="0,10,0,0"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <Grid x:Name="CompletePage" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
              <Border Width="112" Height="112" CornerRadius="56" Background="#FFF9E6" Padding="8">
                <Image Source="pack://application:,,,/Assets/logo.png" Stretch="Uniform"/>
              </Border>
              <TextBlock Text="Ananda Sangha" Foreground="#0B2F6B" FontSize="32" FontWeight="SemiBold"
                         HorizontalAlignment="Center" Margin="0,22,0,0"/>
              <TextBlock Text="Installation completed successfully!" Foreground="#55708A" FontSize="14"
                         HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
          </Grid>
        </Grid>

        <Border VerticalAlignment="Bottom" BorderBrush="#E5EBF1" BorderThickness="0,1,0,0" Padding="36,20">
          <Grid>
            <Button x:Name="CancelButton" Content="Cancel" Width="92" HorizontalAlignment="Left"
                    Background="Transparent" BorderBrush="#C8D6E4" Foreground="#526B84" Click="CancelButton_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="BackButton" Content="Back" Width="92" Background="White" BorderBrush="#C8D6E4"
                      Foreground="#173E6A" Margin="0,0,10,0" Click="BackButton_Click"/>
              <Button x:Name="NextButton" Content="Next" Width="112" Background="#0B2F6B" BorderBrush="#0B2F6B"
                      Foreground="White" Click="NextButton_Click"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
